# ─────────────────────────────────────────────────────────────────────────────
# Meridian — environment
#
# Copy to `.env.local` for local development. In Vercel, add each of these
# under Project Settings → Environment Variables.
#
# Everything here is OPTIONAL. With nothing configured the terminal still runs:
# prices come from a correlated simulation and personal data is saved to
# localStorage. Each key you add lights up more of the product, and the
# Markets page shows exactly which providers are live.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ MARKET DATA ═════════════════════════════════════════════════════════════
#
# Meridian routes across several providers rather than depending on one. The
# rule is: spend the scarcest budget last.
#
#   Finnhub        60/min    US quotes, news, analyst consensus, earnings, peers
#   CoinGecko      ~25/min   crypto quotes + history (works with NO key)
#   Twelve Data     8/min    India/NSE (nothing else covers it) + all history
#   FMP           250/day    fundamentals only, cached 24h
#   Alpha Vantage  25/day    last-resort fallback
#
# Add Finnhub first — it has the largest budget and unlocks the most features.


# ── Finnhub ──────────────────────────────────────────────────────────────────
# https://finnhub.io/register  (free, no card)
# Primary source for US quotes, and the ONLY source for news, analyst ratings,
# earnings history and peers. Highest-value key in this file.
FINNHUB_API_KEY=

# ── Twelve Data ──────────────────────────────────────────────────────────────
# https://twelvedata.com/account/api-keys
# The only provider here whose coverage reaches NSE/BSE, and the source of all
# price history. Its free tier is US-only, so Indian quotes will read
# "Simulated" until you upgrade — that is a plan boundary, not a bug.
TWELVE_DATA_API_KEY=

# Credits per minute allowed by your plan. This SIZES THE GOVERNOR — set it to
# your real limit. A batch quote for 20 symbols costs 20 credits, not 1.
TWELVE_DATA_CREDITS_PER_MINUTE=8

# ── CoinGecko ────────────────────────────────────────────────────────────────
# https://www.coingecko.com/en/api  (a key is OPTIONAL — crypto works without)
# A free demo key raises the rate ceiling from ~30/min to ~100/min.
COINGECKO_API_KEY=

# ── Financial Modeling Prep ──────────────────────────────────────────────────
# https://site.financialmodelingprep.com/developer/docs
# Fundamentals: P/E, margins, ROE, leverage. 250 calls per DAY, so it is used
# only for the fundamentals panel and cached for 24 hours.
FMP_API_KEY=

# ── Alpha Vantage ────────────────────────────────────────────────────────────
# https://www.alphavantage.co/support/#api-key
# 25 calls/day. Wired up as a spare tyre — last in every chain, never consulted
# while a provider with headroom exists.
ALPHA_VANTAGE_API_KEY=


# ═══ ACCOUNTS & SYNC (Firebase) ══════════════════════════════════════════════
#
# Optional. Without these, watchlist / portfolio / alerts persist to
# localStorage and everything still works — you just cannot sync across
# devices. Anything saved as a guest is lifted into the account on first
# sign-in, so adding this later loses nothing.

# ── Client SDK ───────────────────────────────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app.
# These are public by design; Firestore security rules are what protect data.
# Remember to deploy firestore.rules (it ships in this repo).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Admin SDK (server only) ──────────────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private
# key. Used to mint and verify httpOnly session cookies.
#
# NEVER commit the downloaded .json file. .gitignore blocks the usual names,
# but the safe move is to copy the three values out and delete the file.
#
# FIREBASE_PRIVATE_KEY must keep its newlines. Paste it with literal "\n"
# escapes inside double quotes, exactly as shown.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternative to the three vars above: the whole service-account JSON on one
# line, raw or base64-encoded. Convenient for dashboards that mangle newlines.
FIREBASE_SERVICE_ACCOUNT=


# ═══ SITE ════════════════════════════════════════════════════════════════════
# Used for canonical URLs, sitemap and social cards. Defaults to the Vercel URL.
NEXT_PUBLIC_SITE_URL=
