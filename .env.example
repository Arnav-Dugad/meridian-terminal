# ─────────────────────────────────────────────────────────────────────────────
# Meridian — environment
# Copy to `.env.local` for local development. In Vercel, add each of these
# under Project Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twelve Data ──────────────────────────────────────────────────────────────
# https://twelvedata.com/account/api-keys
# Server-only. Never prefix this with NEXT_PUBLIC_ — the key must not reach the
# browser. All market data is proxied through /api/* route handlers.
TWELVE_DATA_API_KEY=

# Credits per minute allowed by your Twelve Data plan. The server-side limiter
# throttles outbound requests to stay under this. Free tier = 8.
TWELVE_DATA_CREDITS_PER_MINUTE=8

# ── Firebase (client SDK) ────────────────────────────────────────────────────
# https://console.firebase.google.com → Project settings → Your apps → Web app
# These are public by design; Firestore security rules are what protect data.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase (Admin SDK — server only) ───────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private
# key. Used to mint and verify httpOnly session cookies.
#
# FIREBASE_PRIVATE_KEY must keep its newlines. Either paste it with literal
# "\n" escapes inside double quotes (as below), or paste the whole JSON blob
# into FIREBASE_SERVICE_ACCOUNT instead and leave these three blank.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Alternative to the three vars above: the entire service-account JSON on one
# line, optionally base64-encoded. Convenient for Vercel.
FIREBASE_SERVICE_ACCOUNT=
